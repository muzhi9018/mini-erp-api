<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.muzhi.minierp.mapper.website.WebsiteProductMapper">

    <select id="selectByIdForUpdate" resultType="com.muzhi.minierp.entity.website.WebsiteProduct">
        SELECT id
        FROM website_product
        WHERE id = #{id} AND is_deleted = false
        FOR UPDATE
    </select>
</mapper>
