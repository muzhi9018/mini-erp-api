<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.muzhi.minierp.mapper.system.SysRoleMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="baseResultMap" type="com.muzhi.minierp.entity.system.SysRole">
        <id column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="create_user" property="createUser"/>
        <result column="update_user" property="updateUser"/>
        <result column="is_deleted" property="deleted"/>
        <result column="status" property="status"/>
        <result column="sort" property="sort"/>
        <result column="role_name" property="roleName"/>
        <result column="remark" property="remark"/>
        <result column="role_code" property="roleCode"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="base_column_list">
        id
        ,
        gmt_create,
        gmt_modified,
        create_user,
        update_user,
        is_deleted,
        status,
        sort,
        role_name,
        remark,
        role_code
    </sql>

    <select id="findByPage" resultType="com.muzhi.minierp.vo.SysRoleVO">
        select
        <include refid="base_column_list"/>
        from sys_role
        where is_deleted = false
        <include refid="base_condition"/>
        order by sort asc, id
    </select>

    <select id="findByCodes" resultType="com.muzhi.minierp.entity.system.SysRole">
        select
        <include refid="base_column_list"/>
        from sys_role
        where is_deleted = false
        and role_code in
        <foreach collection="roleCodes" item="roleCode" index="index" open="(" separator="," close=")">
            #{roleCode}
        </foreach>
    </select>

    <sql id="base_condition">
        <if test="query.roleName != null and '' != query.roleName">
            and role_name like concat('%', #{query.roleName}, '%')
        </if>
        <if test="query.roleCode != null and '' != query.roleCode">
            and role_code like concat('%', #{query.roleCode}, '%')
        </if>
        <if test="query.remark != null and '' != query.remark">
            and remark like concat('%', #{query.remark}, '%')
        </if>
        <if test="query.status != null">
            and status = #{query.status}
        </if>
    </sql>
</mapper>
