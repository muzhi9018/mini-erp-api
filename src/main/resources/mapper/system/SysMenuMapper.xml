<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.muzhi.minierp.mapper.system.SysMenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="baseResultMap" type="com.muzhi.minierp.entity.system.SysMenu">
        <id column="id" property="id" />
        <result column="parent_id" property="parentId" />
        <result column="hierarchy" property="hierarchy" />
        <result column="client_id" property="clientId" />
        <result column="type" property="type" />
        <result column="name" property="name" />
        <result column="i18n_code" property="i18nCode" />
        <result column="path" property="path" />
        <result column="component" property="component" />
        <result column="icon" property="icon" />
        <result column="permission_code" property="permissionCode" />
        <result column="sort" property="sort" />
        <result column="gmt_create" property="gmtCreate" />
        <result column="gmt_modified" property="gmtModified" />
        <result column="create_user" property="createUser" />
        <result column="update_user" property="updateUser" />
        <result column="is_deleted" property="deleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="base_column_list">
        id,
        parent_id,
        hierarchy,
        client_id,
        type,
        name,
        i18n_code,
        path,
        component,
        icon,
        permission_code,
        sort,
        gmt_create,
        gmt_modified,
        create_user,
        update_user,
        is_deleted
    </sql>

    <delete id="delById">
        delete from sys_menu where id = #{id}
    </delete>

    <select id="findTopLevelMenu" resultType="com.muzhi.minierp.entity.system.SysMenu">
        select
        <include refid="base_column_list"/>
        from sys_menu
        where parent_id = 0
        and is_deleted = false
        order by sort, id
    </select>
    <select id="findByParentId" resultType="com.muzhi.minierp.entity.system.SysMenu">
        select
        <include refid="base_column_list"/>
        from sys_menu
        where parent_id = #{parentId}
        and is_deleted = false
        order by sort, id
    </select>

    <select id="findByClientIdAndParentId" resultType="com.muzhi.minierp.entity.system.SysMenu">
        select
        <include refid="base_column_list"/>
        from sys_menu
        where parent_id = #{parentId}
        and client_id = #{clientId}
        and is_deleted = false
    </select>

    <select id="findByIds" resultType="com.muzhi.minierp.entity.system.SysMenu">
        select
        <include refid="base_column_list"/>
        from sys_menu
        where is_deleted = false
        and id in
        <foreach collection="ids" item="id" index="index" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
