<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.muzhi.minierp.mapper.system.SysRolePermissionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="baseResultMap" type="com.muzhi.minierp.entity.system.SysRolePermission">
        <id column="id" property="id" />
        <result column="gmt_create" property="gmtCreate" />
        <result column="gmt_modified" property="gmtModified" />
        <result column="create_user" property="createUser" />
        <result column="update_user" property="updateUser" />
        <result column="role_id" property="roleId" />
        <result column="menu_id" property="menuId" />
        <result column="permission_code" property="permissionCode" />
        <result column="role_code" property="roleCode" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="base_column_list">
        id,
        gmt_create,
        gmt_modified,
        create_user,
        update_user,
        role_id,
        menu_id,
        role_code,
        permission_code
    </sql>

    <insert id="insertBatch" parameterType="com.muzhi.minierp.entity.system.SysRolePermission">
        insert into sys_role_permission
        (
        id,
        gmt_create,
        gmt_modified,
        create_user,
        update_user,
        role_id,
        menu_id,
        role_code,
        permission_code
        )
        values
        <foreach collection="list" item="item" index="index" open="" separator="," close="">
            (
            #{item.id},
            #{item.gmtCreate},
            #{item.gmtModified},
            #{item.createUser},
            #{item.updateUser},
            #{item.roleId},
            #{item.menuId},
            #{item.roleCode},
            #{item.permissionCode}
            )
        </foreach>

    </insert>

    <delete id="deleteByRoleId">
        delete from sys_role_permission where role_id = #{roleId}
    </delete>

    <delete id="deleteByMenuId">
        delete from sys_role_permission where menu_id = #{menuId}
    </delete>

    <update id="updatePermissionCodeByMenuId">
        update
            sys_role_permission
        set permission_code = #{permissionCode}
        where menu_id = #{menuId}
    </update>

</mapper>
