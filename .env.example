# 可选：复制为 .env 后调整部署参数。
# 默认业务配置来自 application-pro.yaml；需要覆盖时取消对应项的注释并填写真实值。
APP_IMAGE=mini-erp:1.0.0
APP_PORT=8081
APP_MEMORY_LIMIT=1g
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=pro

# PostgreSQL：填写已有数据库容器名或容器可访问的地址，不能使用容器自身的 localhost。
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mini_erp
# SPRING_DATASOURCE_USERNAME=your_username
# SPRING_DATASOURCE_PASSWORD='your_password'

# Redis：填写已有 Redis 容器名或可访问的地址，无密码时可设为空。
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_DATABASE=0
# SPRING_DATA_REDIS_PASSWORD='your_password'

# JWT：密钥按 UTF-8 编码后至少需要 32 字节，请填写独立生成的随机密钥。
# SECURITY_JWT_SECRET='your_random_secret'
# SECURITY_JWT_ISSUER=https://www.muzhi.store
# SECURITY_JWT_EXPIREMINUTES=60

# OSS：环境变量按 Spring Boot 规则移除属性名中的连字符。
# OSS_ACCESSKEY=your_access_key
# OSS_SECRETKEY='your_secret_key'
# OSS_BUCKETNAME=your_bucket
# OSS_INTERNALENDPOINT=https://your-internal-endpoint
# OSS_EXTERNALENDPOINT=https://your-external-endpoint

# JVM：随机数种子来源为 /dev/urandom，堆上限为容器内存的 75%，剩余内存供线程及原生库使用。
# JAVA_TOOL_OPTIONS=-Djava.security.egd=file:/dev/urandom -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
